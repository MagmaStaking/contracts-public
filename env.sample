# Deploy Script Environment Variables
# Copy this file to .env and replace these sample values with actual addresses and values for your deployment

# The underlying asset contract address (e.g., WMON token address)
# This should be the address of the ERC20 token that the vault will accept
UNDERLYING_ASSET=0x760AfE86e5de5fa0Ee542fc7B7B713e1c5425701

# Address that will receive fees from the protocol
FEE_RECEIVER=0xYourFeeReceiverAddressHere

# Rewards fee in basis points (100 basis points = 1%)
# Example: 50 = 0.5%, 100 = 1%, 500 = 5%
REWARDS_FEE=10

# Withdrawal fee in basis points (should be 0 on deployment per script requirement)
WITHDRAWAL_FEE=0
